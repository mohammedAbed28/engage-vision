# Optional override; the default is ../model/runtime relative to this backend.
ENGAGEVISION_CORE_DIR=
ENGAGEVISION_EXPECTED_BUNDLE_SHA256=10e5ce9ebbdc8a4cb35f05e1ca27a45cb9c50983e6423e929facdc9d81cc5f02
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=engagevision_final_eel
DB_MAIN_TABLE=safespace
OPENAI_API_KEY=
OPENAI_IMAGE_EDIT_MODEL=gpt-image-2
OPENAI_TEXT_MODEL=gpt-5.6-terra
# Two image candidates are generated and billed, then the frozen model keeps
# only the strongest measured candidate. Allowed range: 1-3.
IMAGE_EDIT_CANDIDATES=2
# Generate a second diverse caption batch only when the first batch does not
# reach the measured improvement target. Allowed range: 1-2.
CAPTION_CANDIDATE_ROUNDS=2
# A revision must add at least two probability points to be offered as a
# meaningful improvement. Values are probabilities: 0.02 = 2 percentage points.
MEANINGFUL_CAPTION_DELTA=0.02
MEANINGFUL_IMAGE_DELTA=0.02
MAX_UPLOAD_BYTES=12582912
MAX_IMAGE_PIXELS=40000000
